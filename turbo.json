{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["*"],
  "tasks": {
    "start": {
      "dependsOn": ["^start"],
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "//#lint": {},
    "//#format": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    "db:update": { "cache": false },
    "db:generate": { "cache": false }
  }
}
